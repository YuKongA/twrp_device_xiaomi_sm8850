# Started from init.recovery.qcom.rc once by-name links exist.
service vendor.qseecomd /vendor/bin/qseecomd
    disabled
    socket notify-topology stream 660 system drmrpc
    class core
    user root
    group root drmrpc
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64:/sbin:/odm/lib64
    seclabel u:r:recovery:s0
